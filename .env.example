# Google AI Studio で発行したAPIキー（https://aistudio.google.com/）
GOOGLE_GENERATIVE_AI_API_KEY=

# ④不動産業務管理APIの本番URL
REALESTATE_API_BASE_URL=https://realestate-api-phi.vercel.app

# ④のデモ用エージェントアカウント（createViewingのJWT取得に使用・サーバー側のみ）
DEMO_AGENT_EMAIL=demo-agent@example.com
DEMO_AGENT_PASSWORD=

# 承認引数のHMAC署名用シークレット（十分に長いランダム文字列。例: openssl rand -hex 32 で生成）
APPROVAL_SIGNATURE_SECRET=

# Langfuse（トレーシング。cloud.langfuse.com のプロジェクト設定 → API Keys で発行）
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
